# Copy to `.env`. Every key is optional unless stated.

# --- Determinism (§4, I8) -------------------------------------------------
# Must be set BEFORE the interpreter starts; it cannot be applied from inside
# Python. `just` and CI set it for you. Set it in your shell profile if you run
# pytest or `alpha` directly.
PYTHONHASHSEED=0

# --- Artifact store -------------------------------------------------------
# Root of the immutable run store. Defaults to ./runs
ALPHA__RUNS_DIR=runs

# Root of the point-in-time data lake. Defaults to ./data
ALPHA__DATA_DIR=data

# --- Logging --------------------------------------------------------------
# TRACE | DEBUG | INFO | SUCCESS | WARNING | ERROR | CRITICAL
ALPHA__LOG_LEVEL=INFO

# --- Provider credentials (Phase 1) --------------------------------------
# Required only for the `alphavantage` provider. `yahoo`, `binance` and `csv`
# need no key.
ALPHA__ALPHAVANTAGE_API_KEY=

# --- API service (Phase 11) ----------------------------------------------
# Optional single bearer token. Empty means the API is unauthenticated, which
# is the intended posture for a single-user local tool (§1).
ALPHA__API_TOKEN=
